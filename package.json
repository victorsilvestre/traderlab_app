{
  "name": "traderlab",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev:web": "pnpm --filter @traderlab/web dev",
    "dev:api": "pnpm --filter @traderlab/api dev",
    "dev": "pnpm run dev:web",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
