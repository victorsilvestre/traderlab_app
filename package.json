{
  "name": "traderlab",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev:web": "pnpm --filter @traderlab/web dev",
    "dev:admin": "pnpm --filter @traderlab/admin dev",
    "dev:api": "pnpm --filter @traderlab/api dev",
    "dev": "pnpm --parallel --filter @traderlab/web --filter @traderlab/admin --filter @traderlab/api run dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm check:text-encoding && pnpm -r lint",
    "check:text-encoding": "node scripts/check-text-encoding.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
