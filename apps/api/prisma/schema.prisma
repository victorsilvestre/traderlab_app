generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  MENTOR
  ADMINISTRATOR

  @@map("user_role")
}

enum PublicationStatus {
  DRAFT
  PUBLISHED

  @@map("publication_status")
}

enum CourseContentKind {
  LESSON
  MATERIAL

  @@map("course_content_kind")
}

enum EnrollmentStatus {
  ACTIVE
  REVOKED

  @@map("enrollment_status")
}

enum EnrollmentSource {
  PURCHASE
  INVITATION
  MANUAL

  @@map("enrollment_source")
}

enum NotificationAudience {
  GENERAL
  COURSE

  @@map("notification_audience")
}

model UserProfile {
  id        String   @id @db.Uuid
  name      String   @db.VarChar(120)
  phone     String   @db.VarChar(30)
  email     String?  @db.VarChar(254)
  avatarPath String?  @map("avatar_path") @db.VarChar(512)
  role      UserRole @default(STUDENT)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdCourses         Course[]                @relation("CourseCreator")
  enrollments            Enrollment[]
  progress               ContentProgress[]
  createdBanners         HomeBanner[]            @relation("HomeBannerCreator")
  updatedBanners         HomeBanner[]            @relation("HomeBannerUpdater")
  createdNotifications   Notification[]          @relation("NotificationAuthor")
  updatedNotifications   Notification[]          @relation("NotificationUpdater")
  notificationRecipients NotificationRecipient[]

  @@map("user_profiles")
}

model HomeBanner {
  id             Int               @id @default(autoincrement())
  internalName   String            @map("internal_name") @db.VarChar(180)
  description    String            @default("") @db.Text
  eyebrowText    String?           @map("eyebrow_text") @db.VarChar(180)
  overlayText    String?           @map("overlay_text") @db.VarChar(500)
  imagePath      String            @map("image_path") @db.VarChar(2048)
  destinationUrl String?           @map("destination_url") @db.VarChar(2048)
  altText        String            @map("alt_text") @db.VarChar(500)
  status         PublicationStatus @default(DRAFT)
  displayOrder   Int               @default(0) @map("display_order")
  createdById    String?           @map("created_by_id") @db.Uuid
  updatedById    String?           @map("updated_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy UserProfile? @relation("HomeBannerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy UserProfile? @relation("HomeBannerUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, displayOrder])
  @@map("home_banners")
}

model Notification {
  id          Int                  @id @default(autoincrement())
  title       String               @db.VarChar(180)
  description String               @db.VarChar(3000)
  linkUrl     String?              @map("link_url") @db.VarChar(2048)
  audience    NotificationAudience
  courseId    Int?                 @map("course_id")
  status      PublicationStatus    @default(DRAFT)
  createdById String?              @map("created_by_id") @db.Uuid
  updatedById String?              @map("updated_by_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime?            @map("published_at") @db.Timestamptz(6)

  course     Course?                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy  UserProfile?            @relation("NotificationAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  UserProfile?            @relation("NotificationUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  recipients NotificationRecipient[]

  @@index([audience, courseId, status, publishedAt])
  @@map("notifications")
}

model NotificationRecipient {
  notificationId Int       @map("notification_id")
  userId         String    @map("user_id") @db.Uuid
  recipientEmail String?   @map("recipient_email") @db.VarChar(254)
  deliveredAt    DateTime  @default(now()) @map("delivered_at") @db.Timestamptz(6)
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt, deliveredAt])
  @@map("notification_recipients")
}

model Course {
  id            Int               @id @default(autoincrement())
  createdById   String            @map("created_by_id") @db.Uuid
  title         String            @db.VarChar(180)
  description   String            @db.Text
  coverImageUrl String?           @map("cover_image_url") @db.VarChar(2048)
  coverImagePath String?          @map("cover_image_path") @db.VarChar(512)
  status        PublicationStatus @default(DRAFT)
  publishedAt   DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy     UserProfile    @relation("CourseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  modules       CourseModule[]
  enrollments   Enrollment[]
  notifications Notification[]

  @@index([status, publishedAt])
  @@index([createdById])
  @@map("courses")
}

model CourseModule {
  id          Int               @id @default(autoincrement())
  courseId    Int               @map("course_id")
  title       String            @db.VarChar(180)
  description String            @default("") @db.Text
  imageUrl    String?           @map("image_url") @db.VarChar(2048)
  imagePath   String?           @map("image_path") @db.VarChar(512)
  position    Int               @default(0)
  status      PublicationStatus @default(DRAFT)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  course   Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contents CourseContent[]

  @@index([courseId, status, position])
  @@map("course_modules")
}

model CourseContent {
  id          Int               @id @default(autoincrement())
  moduleId    Int               @map("module_id")
  title       String            @db.VarChar(180)
  description String            @default("") @db.Text
  kind        CourseContentKind
  body        String            @default("") @db.Text
  videoUrl    String?           @map("video_url") @db.VarChar(2048)
  resourceUrl String?           @map("resource_url") @db.VarChar(2048)
  imagePath   String?           @map("image_path") @db.VarChar(512)
  position    Int               @default(0)
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  module    CourseModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  ContentProgress[]
  materials CourseMaterial[]

  @@index([moduleId, status, position])
  @@map("course_contents")
}

model CourseMaterial {
  id          Int      @id @default(autoincrement())
  contentId   Int      @map("content_id")
  name        String   @db.VarChar(240)
  description String   @default("") @db.VarChar(500)
  storagePath String   @map("storage_path") @db.VarChar(1024)
  mimeType    String   @map("mime_type") @db.VarChar(160)
  sizeBytes   Int      @map("size_bytes")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  content CourseContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, position])
  @@map("course_materials")
}

model Enrollment {
  id        Int              @id @default(autoincrement())
  studentId String           @map("student_id") @db.Uuid
  courseId  Int              @map("course_id")
  source    EnrollmentSource
  status    EnrollmentStatus @default(ACTIVE)
  grantedAt DateTime         @default(now()) @map("granted_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  student UserProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@map("enrollments")
}

model ContentProgress {
  id             Int       @id @default(autoincrement())
  studentId      String    @map("student_id") @db.Uuid
  contentId      Int       @map("content_id")
  lastAccessedAt DateTime  @default(now()) @map("last_accessed_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  student UserProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content CourseContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([studentId, contentId])
  @@index([studentId, lastAccessedAt])
  @@map("content_progress")
}
