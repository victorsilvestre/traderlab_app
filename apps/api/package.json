{
  "name": "@traderlab/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && node --env-file=.env --import tsx --watch src/server.ts",
    "start": "prisma generate && node --env-file=.env --import tsx src/server.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "storage:ensure-course-materials": "node --env-file=.env scripts/provision-course-materials-bucket.mjs",
    "db:seed:courses": "node --env-file=.env prisma/seed-example-courses.mjs",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "build": "prisma generate && tsc --outDir dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@traderlab/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.117.2",
    "fastify": "^5.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "dotenv": "^16.6.1",
    "prisma": "^7.10.0",
    "tsx": "^4.20.0"
  }
}
